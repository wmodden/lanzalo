---
import Layout from '../layouts/Layout.astro';
---

<Layout title='Home'>
  <section class='max-w-7xl px-6 lg:px-8 mt-24 sm:mt-32 md:mt-56'>
    <div class='max-w-3xl'>
      <h1
        class='text-5xl font-medium tracking-tighter text-balance text-neutral-950 sm:text-7xl'
      >
        Lanza tu MVP en tiempo record sin romper el banco
      </h1>
      <p class='mt-6 text-xl text-neutral-600'>
        Transformamos tus ideas en productos reales en menos de 4 semanas.
        Trabajamos con fundadores de startups para lanzar MVPs rápidos,
        funcionales y listos para validación en el mercado
      </p>
    </div>
  </section>
</Layout>
